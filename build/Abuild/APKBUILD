# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=intltool
pkgver=0.51.0
pkgrel=9
pkgdesc="The internationalization tool collection"
url="https://www.freedesktop.org/wiki/Software/intltool"
arch="noarch"
license="GPL-2.0-or-later"
depends="perl perl-xml-parser gettext file"
subpackages="$pkgname-doc"
source="https://launchpad.net/intltool/trunk/$pkgver/+download/$pkgname-$pkgver.tar.gz
	intltool-perl-regexp.patch"

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
}


